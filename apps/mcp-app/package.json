    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.19.21",
    "tsdown": "0.21.10",
    "tsx": "4.23.0",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  }
}
