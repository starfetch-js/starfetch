{
  "name": "@starfetch-js/mcp-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "npm run build:web && tsdown --config tsdown.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "browser:serve": "vite --config web/vite.config.ts --host 127.0.0.1 --port 5174",
    "check": "npm run typecheck && npm run test && npm run build",
    "dev": "npm run build:web && tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run && npm run test:web",
    "test:browser": "npm run build:web && playwright test --config web/playwright.config.ts",
    "test:web": "vitest run --config web/vitest.config.ts",
    "typecheck": "tsc -p tsconfig.typecheck.json && tsc -p web/tsconfig.json"
  },
  "dependencies": {
    "@hono/node-server": "1.19.14",
    "@modelcontextprotocol/ext-apps": "1.7.4",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@shikijs/core": "4.3.1",
    "@shikijs/engine-javascript": "4.3.1",
    "@shikijs/langs": "4.3.1",
    "@shikijs/themes": "4.3.1",
    "@starfetch-js/mcp": "0.2.3",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.14.6",
    "hono": "4.12.27",
    "ipaddr.js": "2.4.0",
    "lucide-react": "1.24.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "undici": "7.28.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.19.21",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "jsdom": "29.1.1",
    "terser": "5.49.0",
    "tsdown": "0.21.10",
    "tsx": "4.23.0",
    "typescript": "6.0.3",
    "vite": "8.1.4",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "4.1.9"
  }
}
