{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "ignoreDeprecations": "6.0",
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@starfetch-js/core": ["packages/core/src/index.ts"],
      "@starfetch-js/mcp": ["packages/mcp/src/index.ts"],
      "@starfetch-js/skill": ["packages/skill/src/index.ts"]
    }
  },
  "include": [
    "apps/*/*.ts",
    "apps/*/src/**/*.ts",
    "apps/*/test/**/*.ts",
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "eslint.config.js",
    "tsdown.config.ts",
    "vitest.config.ts"
  ]
}
