{
  "name": "@starfetch-js/mcp",
  "version": "0.2.1",
  "mcpName": "io.github.starfetch-js/starfetch",
  "description": "MCP server for querying Gaia, SIMBAD, VizieR, NASA Exoplanet Archive, IRSA, and other public astronomy catalogs.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "astronomy",
    "gaia",
    "simbad",
    "vizier",
    "exoplanets",
    "nasa-exoplanet-archive",
    "irsa",
    "star-catalog",
    "virtual-observatory",
    "tap",
    "adql",
    "mcp",
    "model-context-protocol",
    "ai-agent",
    "claude",
    "cursor",
    "codex"
  ],
  "homepage": "https://github.com/starfetch-js/starfetch#readme",
  "bugs": {
    "url": "https://github.com/starfetch-js/starfetch/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/starfetch-js/starfetch.git",
    "directory": "packages/mcp"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "starfetch-mcp": "dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsdown --config ../../tsdown.config.ts",
    "smoke": "node test/stdio-smoke.mjs",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@starfetch-js/core": "0.2.1",
    "@starfetch-js/skill": "0.2.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.19.21",
    "tsdown": "0.21.10",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  },
  "publishConfig": {
    "access": "public"
  }
}
