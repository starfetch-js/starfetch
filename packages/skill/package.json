{
  "name": "@starfetch-js/skill",
  "version": "0.2.1",
  "description": "Agent skill for safe, reproducible queries of Gaia, SIMBAD, VizieR, and other public astronomy catalogs.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "astronomy",
    "gaia",
    "simbad",
    "vizier",
    "exoplanets",
    "nasa-exoplanet-archive",
    "irsa",
    "star-catalog",
    "virtual-observatory",
    "tap",
    "adql",
    "mcp",
    "ai-agent",
    "claude",
    "cursor",
    "codex",
    "agent-skill"
  ],
  "homepage": "https://github.com/starfetch-js/starfetch#readme",
  "bugs": {
    "url": "https://github.com/starfetch-js/starfetch/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/starfetch-js/starfetch.git",
    "directory": "packages/skill"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "skill"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsdown --config ../../tsdown.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "22.19.21",
    "tsdown": "0.21.10",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  },
  "publishConfig": {
    "access": "public"
  }
}
